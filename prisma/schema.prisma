generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?
  image         String?
  locale        String    @default("ko")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  portfolios Portfolio[]
  posts      Post[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  name      String
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets Asset[]
}

model Asset {
  id                String             @id @default(cuid())
  portfolioId       String
  symbol            String
  name              String
  assetType         AssetType
  exchange          String?
  currency          String             @default("USD")
  shares            Float
  avgCost           Float
  // 사용자가 직접 지정하는 목표 리밸런싱 분류(성장 엔진/배당 성장/고배당
  // 캐시카우/안전 자산). AI가 자동 분류하지 않는다 — 어떤 종목을 어느
  // 버킷에 넣을지는 사용자 본인의 투자 전략에 달린 주관적 판단이라
  // 알고리즘으로 추론할 수 없다. 미지정이면 null("미분류").
  rebalanceCategory RebalanceCategory?
  // 이 종목이 어느 계좌(일반/ISA/연금저축/IRP/퇴직연금 IRP)에 들어있는지.
  // 리밸런싱 분류와 마찬가지로 사용자가 직접 지정한다. 미지정이면 null.
  accountType       AccountType?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  dividends    Dividend[]
}

model Transaction {
  id      String          @id @default(cuid())
  assetId String
  type    TransactionType
  shares  Float
  price   Float
  date    DateTime
  note    String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Dividend {
  id       String   @id @default(cuid())
  assetId  String
  amount   Float
  currency String   @default("USD")
  date     DateTime

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Post {
  id            String     @id @default(cuid())
  authorId      String
  title         String
  content       String
  status        PostStatus @default(PUBLISHED)
  removedReason String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum PostStatus {
  PUBLISHED
  REMOVED
}

enum AssetType {
  STOCK
  ETF
  BOND
  CRYPTO
  OTHER
}

enum RebalanceCategory {
  GROWTH_ENGINE
  DIVIDEND_GROWTH
  HIGH_YIELD_CASHCOW
  SAFE_ASSET
}

enum AccountType {
  GENERAL
  ISA
  PENSION_SAVINGS
  IRP
  RETIREMENT_PENSION_IRP
}

enum TransactionType {
  BUY
  SELL
}
