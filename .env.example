# ──────────────────────────────────────────────
# Tibedra 환경변수 예시
# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요.
# (배포 시에는 Vercel 프로젝트 환경변수에 동일하게 등록)
# ──────────────────────────────────────────────

# 사이트 절대 URL (sitemap / robots / OG 에 사용)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense 퍼블리셔 ID  (예: ca-pub-1234567890123456)
# 발급: https://www.google.com/adsense  →  사이트 승인 후 게시자 ID 복사
NEXT_PUBLIC_ADSENSE_CLIENT=

# 광고 슬롯 ID (AdSense > 광고 > 광고 단위 만들기 에서 발급되는 숫자)
# 지면별로 다른 슬롯을 쓰고 싶으면 각각 채우세요. 비워두면 광고가 렌더되지 않습니다.
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Cron 보안 토큰 — /api/revalidate 무단 호출 방지용 (아무 랜덤 문자열)
REVALIDATE_TOKEN=change-me-to-a-random-string

# ── Google Gemini (번역·해설·브리핑·블로그 자동 초안) ──
# 발급: https://aistudio.google.com/apikey  (무료 등급 제공)
# 비워두면 관련 기능이 모두 비활성화됩니다(번역 없이 원문 표시, 해설 없이 요약만 표시 등).
GEMINI_API_KEY=
# 번역·해설·브리핑·블로그 자동 초안이 공통으로 쓰는 모델 (기본: gemini-2.5-flash).
# Google 쪽 모델 세대가 자주 바뀌므로, 값을 바꿀 땐 먼저 실제 API 호출로
# 그 모델명이 이 키에서 유효한지 확인한 뒤 반영하세요(무효한 모델명은 404를
# 내며, 검증 없이 바꿨다가 사이트 번역이 통째로 멈춘 적이 있습니다).
GEMINI_MODEL=gemini-2.5-flash

# ── Groq (Gemini 실패/한도 초과 시 폴백) ──
# 발급: https://console.groq.com/keys (무료 등급 제공)
# 비워두면 이 프로바이더는 조용히 건너뜁니다(폴백 체인에서 자동 제외).
GROQ_API_KEY=
# 아래 모델명은 검증되지 않은 추정값입니다. 실제 키 발급 후 반드시 curl로
# 살아있는 모델인지 먼저 확인한 뒤 사용하세요(무효한 모델명을 검증 없이
# 반영했다가 번역이 전면 장애난 사고가 있었습니다 — 동일 원칙 적용).
GROQ_MODEL=llama-3.3-70b-versatile

# ── Cerebras (Gemini·Groq 실패 시 폴백) ──
# 발급: https://cloud.cerebras.ai (무료 등급 제공)
# 비워두면 이 프로바이더는 조용히 건너뜁니다.
CEREBRAS_API_KEY=
# 아래 모델명도 검증되지 않은 추정값입니다 — GROQ_MODEL과 동일한 이유로
# 반드시 라이브로 확인 후 사용하세요.
CEREBRAS_MODEL=llama-3.3-70b

# ── DeepSeek (앞선 프로바이더들 모두 실패 시 폴백) ──
# 발급: https://platform.deepseek.com/api_keys
# 비워두면 이 프로바이더는 조용히 건너뜁니다.
DEEPSEEK_API_KEY=
# 아래 모델명도 검증되지 않은 추정값입니다 — 반드시 라이브로 확인 후 사용하세요.
DEEPSEEK_MODEL=deepseek-chat

# ── OpenRouter (최후 폴백 — 여러 무료 모델을 모아둔 허브) ──
# 발급: https://openrouter.ai/keys
# 비워두면 이 프로바이더는 조용히 건너뜁니다.
OPENROUTER_API_KEY=
# 2026-07-27 라이브 확인: JSON 모드·한국어 번역 품질 모두 실측 확인함.
# 다만 OpenRouter의 무료 모델 목록은 수시로 바뀌므로(실제로 처음 추정했던
# meta-llama/llama-3.3-70b-instruct:free 는 이미 유료로 전환됨) 나중에
# 이 값이 다시 무효해질 수 있다 — 실패가 잦아지면 https://openrouter.ai/api/v1/models
# 에서 ":free" 접미사가 붙은 현재 목록을 다시 확인하세요.
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# ── 네이버 지역(장소) 검색 API (맛집 섹션) ──
# 발급: https://developers.naver.com → Application 등록 → 사용 API: 검색
# 비워두면 맛집 섹션이 비활성화됩니다(빈 목록으로 표시).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 블로그 관리자 (/admin) ──
# /admin 로그인 비밀번호. 비워두면 관리자 기능 전체가 비활성화됩니다.
ADMIN_PASSWORD=
# 관리자 홈(/admin)의 방문자 통계 카드용. 먼저 Vercel 프로젝트의 Analytics
# 탭에서 Web Analytics를 켜야 데이터가 쌓이기 시작합니다(설치 이전 기간은
# 조회 불가). 그 다음 vercel.com/account/tokens 에서 이 프로젝트에 접근
# 가능한 토큰을 발급해 채우세요. 비워두면 통계 카드 대신 설정 안내만 표시됩니다.
VERCEL_ANALYTICS_API_TOKEN=
# 관리자 발행 글·매일 자동 초안·브리핑 아카이브 저장소(private). Vercel 프로젝트에
# Blob 스토어를 연결하면 BLOB_STORE_ID 가 자동으로 채워집니다(OIDC 인증, 별도
# 토큰 불필요). 로컬에서 이 값이 없으면 해당 기능들은 조용히 비활성화됩니다.
BLOB_STORE_ID=
# 블로그 글 대표 이미지 업로드 전용 스토어(public) 의 ID. 글 데이터 스토어와
# 분리된 이유: Vercel Blob 스토어는 생성 시 public/private 중 하나로 고정되고,
# 공개 페이지에서 <img> 로 바로 보여줄 이미지는 public 이어야 하기 때문.
# `vercel blob create-store <name> --access public` 로 만든 뒤 이 값을 채우세요.
BLOG_IMAGES_STORE_ID=

# ── 포트폴리오 (/portfolio) ──
# 회원가입/로그인·포트폴리오·자산을 저장하는 PostgreSQL 연결 문자열.
# Vercel Marketplace(Neon 등)에서 발급받은 값을 채우세요. 비워두면 /portfolio
# 전체가 동작하지 않습니다(뉴스 사이트 나머지 페이지는 영향 없음).
DATABASE_URL=
# NextAuth 세션 서명 키. 생성: `npx auth secret` 또는 `openssl rand -base64 32`
AUTH_SECRET=
